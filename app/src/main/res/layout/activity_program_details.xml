<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du programme"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtDetailLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Niveau"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtDetailObjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Objectif"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtDetailDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Durée"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtDetailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prix"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Localisation"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtConversionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConvertPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Convertir le prix EUR / USD" />

        <Button
            android:id="@+id/btnShareProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partager le programme"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnOpenLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ouvrir localisation"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSendGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envoyer mon objectif au coach"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>