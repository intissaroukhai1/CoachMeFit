<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_coach_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/txtGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mon objectif"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Décrivez votre objectif sportif pour le coach."
            android:textSize="15sp"
            android:textColor="#DDEFE3"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/coach_card_bg"
            android:elevation="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Envoyer votre objectif"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Votre demande sera envoyée au coach."
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginBottom="22dp" />

            <!-- Programme -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programme sélectionné"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtProgramName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programme :"
                android:textSize="15sp"
                android:textColor="#333333"
                android:background="@drawable/detail_info_bg"
                android:padding="14dp"
                android:layout_marginBottom="18dp" />

            <!-- Objectif -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Votre objectif"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editGoal"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:hint="Ex : Je veux perdre 5 kg et améliorer mon endurance"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:minLines="4"
                android:padding="16dp"
                android:textColor="#111111"
                android:textColorHint="#999999"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="24dp" />

            <!-- Button -->
            <Button
                android:id="@+id/btnSendGoalResult"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Envoyer au coach"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/login_button_bg" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>