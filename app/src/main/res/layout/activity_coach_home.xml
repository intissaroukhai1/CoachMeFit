<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Titre de la page Coach -->
    <TextView
        android:id="@+id/txtCoachTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Espace Coach"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="20dp" />

    <!-- Petite description -->
    <TextView
        android:id="@+id/txtCoachSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenue Coach, choisissez une action :"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <!-- ListView pour afficher le menu du coach -->
    <ListView
        android:id="@+id/listCoachMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="1dp" />

</LinearLayout>